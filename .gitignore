# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test, coverage, and type-checking caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
hypothesis/

# Logs and runtime files
*.log
*.pid
*.pid.lock

# Local databases
*.db
*.sqlite
*.sqlite3

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Keep the reproducible dependency lockfile
!uv.lock
