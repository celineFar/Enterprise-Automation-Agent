# Relay - Release 0, Phase 1 local development configuration
#
# Copy this file to .env before starting the application:
#   Copy-Item .env.example .env
#
# Double underscores represent nested pydantic-settings fields. Application
# settings use the AGENT_ prefix required by the architecture. Values below are
# local-development defaults only; staging and production must inject settings
# and secrets through their managed runtime and secret manager.

# Application identity
AGENT_APPLICATION__NAME=relay-agent-platform
AGENT_APPLICATION__ENVIRONMENT=local
AGENT_APPLICATION__LOG_LEVEL=INFO
AGENT_APPLICATION__DEPLOYMENT_ID=local-development

# Build and deployment metadata
# CI replaces these values when it builds the application image.
AGENT_BUILD__VERSION=0.1.0-dev
AGENT_BUILD__COMMIT_SHA=local
AGENT_BUILD__IMAGE_DIGEST=local

# PostgreSQL
# These credentials are intentionally limited to the local Docker Compose stack.
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_PORT=5432
AGENT_DATABASE__URL=postgresql+psycopg://relay:relay@localhost:5432/relay
AGENT_DATABASE__POOL_SIZE=5
AGENT_DATABASE__MAX_OVERFLOW=5
AGENT_DATABASE__POOL_TIMEOUT_SECONDS=30

# API runtime
AGENT_API__HOST=0.0.0.0
AGENT_API__PORT=8000
AGENT_API__WORKERS=1

# Worker runtime
AGENT_WORKER__POLL_INTERVAL_SECONDS=1
AGENT_WORKER__SHUTDOWN_GRACE_PERIOD_SECONDS=30

# OpenTelemetry
# Keep export disabled until the local collector is running. Application logs
# should still include the application, build, deployment, and environment fields.
AGENT_TELEMETRY__ENABLED=false
AGENT_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
AGENT_TELEMETRY__OTLP_INSECURE=true
